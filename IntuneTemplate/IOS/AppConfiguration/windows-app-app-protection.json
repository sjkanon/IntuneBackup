{
  "@odata.type": "#microsoft.graph.iosManagedAppProtection",
  "displayName": "[Baseline] - IOS - U - Windows App Protection",
  "description": "Windows App on every iPhone and iPad, also without enrolment: PIN, no clipboard between the virtual desktop and local apps, screen capture blocked so that Cloud PCs and session hosts with screen capture protection accept the connection, minimum app version for that protection, jailbroken devices blocked.",
  "roleScopeTagIds": [
    "0"
  ],
  "periodOfflineBeforeAccessCheck": "PT12H",
  "periodOnlineBeforeAccessCheck": "PT30M",
  "periodOfflineBeforeWipeIsEnforced": "P30D",
  "pinRequired": true,
  "minimumPinLength": 6,
  "simplePinBlocked": true,
  "pinCharacterSet": "numeric",
  "maximumPinRetries": 5,
  "appActionIfMaximumPinRetriesExceeded": "block",
  "periodBeforePinReset": "PT0S",
  "pinRequiredInsteadOfBiometricTimeout": "PT12H",
  "allowedInboundDataTransferSources": "none",
  "allowedOutboundDataTransferDestinations": "none",
  "allowedOutboundClipboardSharingLevel": "blocked",
  "dataBackupBlocked": true,
  "saveAsBlocked": true,
  "printBlocked": true,
  "contactSyncBlocked": true,
  "organizationalCredentialsRequired": false,
  "deviceComplianceRequired": true,
  "appActionIfDeviceComplianceRequired": "block",
  "appActionIfUnableToAuthenticateUser": "block",
  "notificationRestriction": "blockOrganizationalData",
  "targetedAppManagementLevels": "unspecified",
  "appGroupType": "selectedPublicApps",
  "minimumRequiredAppVersion": "11.2.4",
  "minimumWarningOsVersion": "18.0",
  "thirdPartyKeyboardsBlocked": true,
  "screenCaptureConfigurationState": "blocked",
  "filterOpenInToOnlyManagedApps": true,
  "appDataEncryptionType": "whenDeviceLocked"
}
