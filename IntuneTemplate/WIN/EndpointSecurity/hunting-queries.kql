// App Control for Business — Advanced Hunting (Microsoft Defender XDR)
// ActionTypes as per Microsoft Learn: "Query App Control events with advanced hunting" (August 2026).
// Run 1–3 during the audit phase, 1 and 4 after enforcing.

// 1. Overview: which App Control events, on how many devices (last 7 days)
DeviceEvents
| where Timestamp > ago(7d)
| where ActionType startswith "AppControl"
| summarize Devices = dcount(DeviceName), Events = count() by ActionType
| order by Devices desc

// 2. Audit phase: what would be blocked (3076 + script/MSI 8028), grouped per file
DeviceEvents
| where Timestamp > ago(30d)
| where ActionType in ("AppControlCodeIntegrityPolicyAudited", "AppControlCIScriptAudited")
| extend Fields = parse_json(AdditionalFields)
| summarize Devices = dcount(DeviceId), LastSeen = max(Timestamp), SamplePath = any(FolderPath),
            Publisher = any(tostring(Fields.PublisherName)), SHA256 = any(SHA256)
          by FileName, ActionType
| order by Devices desc

// 3. Origin: allowed, audited or blocked based on ISG reputation or managed installer
DeviceEvents
| where Timestamp > ago(7d)
| where ActionType in ("AppControlCodeIntegrityOriginAllowed", "AppControlCodeIntegrityOriginAudited", "AppControlCodeIntegrityOriginBlocked")
| summarize Count = count() by ActionType, FileName
| order by Count desc

// 4. After enforcing: every block (3077 + script/MSI 8029) with user and parent process
DeviceEvents
| where Timestamp > ago(1d)
| where ActionType in ("AppControlCodeIntegrityPolicyBlocked", "AppControlCIScriptBlocked")
| project Timestamp, DeviceName, InitiatingProcessAccountName, FileName, FolderPath, SHA256,
          InitiatingProcessFileName, AdditionalFields
| order by Timestamp desc

// 5. Check: which devices have loaded the policy (3099) — devices that are missing do not have it
DeviceEvents
| where Timestamp > ago(7d)
| where ActionType == "AppControlCodeIntegrityPolicyLoaded"
| summarize LastSeen = max(Timestamp) by DeviceName
