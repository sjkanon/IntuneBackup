# Shell scripts must keep LF. This repo is maintained on Windows with core.autocrlf=true;
# without this rule a .sh gets CRLF line endings on checkout and fails on the Mac with
# "bad interpreter: /bin/bash^M" — an error you only see once the script has already been
# uploaded.
*.sh text eol=lf

# The filled-in deployment copies in local/ are shell scripts and must therefore keep LF too.
local/*.sh text eol=lf
