{
  "@odata.type": "#microsoft.graph.depMacOSEnrollmentProfile",

  "displayName": "macOS Corporate ADE Baseline",
  "description": "Standaard ADE-enrollmentprofiel voor beheerde bedrijfs-Macs. User affinity, locked enrollment, FileVault afgedwongen door beleid, consumentenschermen verborgen.",

  "isDefault": true,
  "isMandatory": true,
  "supervisedModeEnabled": true,

  "requiresUserAuthentication": true,
  "enableAuthenticationViaCompanyPortal": true,
  "configurationWebUrl": true,
  "requireCompanyPortalOnSetupAssistantEnrolledDevices": true,
  "usePlatformSSODuringSetupAssistant": false,

  "waitForDeviceConfiguredConfirmation": true,
  "profileRemovalDisabled": true,
  "autoAdvanceSetupEnabled": false,
  "requestRequiresNetworkTether": false,

  "adminAccountUserName": "mdmadmin",
  "adminAccountFullName": "IT Servicedesk",
  "hideAdminAccount": true,
  "depProfileAdminAccountPasswordRotationSetting": {
    "@odata.type": "microsoft.graph.depProfileAdminAccountPasswordRotationSetting",
    "autoRotationPeriodInDays": 14,
    "depProfileDelayAutoRotationSetting": {
      "@odata.type": "microsoft.graph.depProfileDelayAutoRotationSetting",
      "onRetrievalAutoRotatePasswordEnabled": true,
      "onRetrievalDelayAutoRotatePasswordInHours": 8
    }
  },

  "skipPrimarySetupAccountCreation": false,
  "setPrimarySetupAccountAsRegularUser": true,
  "dontAutoPopulatePrimaryAccountInfo": false,
  "primaryAccountUserName": "{{partialupn}}",
  "primaryAccountFullName": "{{username}}",
  "enableRestrictEditing": true,

  "supportDepartment": "IT Servicedesk",
  "supportPhoneNumber": "SERVICEDESK-TELEFOON-INVULLEN",

  "locationDisabled": false,
  "touchIdDisabled": false,
  "accessibilityScreenDisabled": false,
  "chooseYourLockScreenDisabled": false,

  "appleIdDisabled": true,
  "restoreBlocked": true,
  "termsAndConditionsDisabled": true,
  "applePayDisabled": true,
  "siriDisabled": true,
  "diagnosticsDisabled": true,
  "iCloudDiagnosticsDisabled": true,
  "iCloudStorageDisabled": true,
  "displayToneSetupDisabled": true,
  "privacyPaneDisabled": true,
  "screenTimeScreenDisabled": true,
  "fileVaultDisabled": true,
  "registrationDisabled": true,
  "passCodeDisabled": true,
  "zoomDisabled": true,
  "autoUnlockWithWatchDisabled": true,

  "enabledSkipKeys": [
    "SoftwareUpdate",
    "UpdateCompleted",
    "EnableLockdownMode",
    "Intelligence",
    "TermsOfAddress",
    "OSShowcase",
    "Wallpaper"
  ],

  "enrollmentTimeAzureAdGroupIds": []
}
